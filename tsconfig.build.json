{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "sourceMap": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowJs": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "chrome-linux64",
    "dist",
    "build",
    "**/*.test.ts"
  ]
}
