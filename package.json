{
  "name": "dscode",
  "version": "2.0.0",
  "private": true,
  "description": "Agente de código en terminal (tipo OpenCode/Claude Code) con motor DeepSeek intercambiable: API real o scraping del chat web. Modos Plan/Build, contexto de proyecto vía AGENTS.md.",
  "type": "module",
  "main": "dist/app/cli.js",
  "bin": {
    "dscode": "./dist/app/cli.js"
  },
  "scripts": {
    "start": "node dist/app/cli.js",
    "login": "node dist/app/cli.js login",
    "calibrate": "node dist/app/cli.js calibrate",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/app/cli.js",
    "dev": "npm run build && node dist/app/cli.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.3",
    "openai": "^4.56.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
