{
  "name": "dscode",
  "version": "2.0.0",
  "private": true,
  "description": "Agente de código en terminal (tipo OpenCode/Claude Code) con motor DeepSeek intercambiable: API real o scraping del chat web. Modos Plan/Build, contexto de proyecto vía AGENTS.md.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "dscode": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "login": "node src/cli.js login",
    "calibrate": "node src/cli.js calibrate",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "execa": "^9.3.0",
    "openai": "^4.56.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
