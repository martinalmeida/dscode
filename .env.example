# dscode 3.2.1 — configuración opcional
#
# La configuración se carga desde el directorio de instalación de dscode,
# no desde el workspace donde ejecutes el agente.

# DeepSeek Web / Playwright
CHAT_URL=https://chat.deepseek.com/
HEADLESS=true
STORAGE_STATE_PATH=./storage-state.json
RESPONSE_TIMEOUT_MS=300000

# Chromium: déjalo vacío para autodetección.
# La autodetección busca primero ./chrome-linux64/chrome desde el directorio
# donde ejecutas dscode, luego el directorio de instalación y finalmente
# navegadores instalados en el sistema / Playwright.
# También puedes indicar una ruta absoluta o una ruta relativa a dscode.
CHROMIUM_EXECUTABLE_PATH=

# Límites de contexto y exploración
DSCODE_MAX_CONTEXT_CHARS=5000
DSCODE_MAX_SEND_CHARS=16000
DSCODE_MAX_TOOL_ITERATIONS=30
DSCODE_MAX_FILE_READ_CHARS=40000
DSCODE_MAX_TOOL_RESULT_CHARS=24000
DSCODE_MAX_READS_PER_FILE=4
DSCODE_MAX_TOTAL_READS=12
DSCODE_COMMAND_TIMEOUT_MS=60000
DSCODE_SEARCH_TIMEOUT_MS=30000
DSCODE_GLOB_LIMIT=200
DSCODE_READ_MANY_LIMIT=40

# Logging
# LOG_LEVEL=warn
# LOG_PRETTY=true

# MODEL_PROVIDER se mantiene solo por compatibilidad con configuraciones antiguas.
# dscode 3.2.1 usa exclusivamente DeepSeek Web mediante Playwright.
# MODEL_PROVIDER=web

# Optional: shown in the CLI header. Do not put secrets here.
DSCODE_ACCOUNT=DeepSeek Web

# Reliability / recovery
DSCODE_MAX_LLM_ATTEMPTS=3
DSCODE_CONTEXT_WARNING_CHARS=90000
DSCODE_CONTEXT_CRITICAL_CHARS=120000
# Persistent task data (default: ~/.dscode/tasks)
# DSCODE_TASK_DIR=
