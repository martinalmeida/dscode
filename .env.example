# ============================================================
# PROVEEDOR DEL MODELO
# ============================================================
# "web" = usa chat.deepseek.com por scraping con Playwright (gratis, frágil)
# "api" = usa la API oficial de DeepSeek (de pago, confiable, function-calling real)
MODEL_PROVIDER=web

# --- Solo si MODEL_PROVIDER=api ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Solo si MODEL_PROVIDER=web ---
CHAT_URL=https://chat.deepseek.com/

# Chromium corre oculto (sin ventana). "dscode login" y "dscode calibrate"
# fuerzan ventana visible siempre, sin importar esto (necesitan que veas
# la pantalla para iniciar sesión).
HEADLESS=true

# Dónde se guarda la sesión logueada (cookies, localStorage). Ruta
# relativa a la carpeta de instalación de dscode (NO al proyecto que
# abras con él) — no hace falta tocar esto normalmente.
STORAGE_STATE_PATH=./storage-state.json

# Timeout máximo (ms) esperando a que termine de generarse una respuesta.
# Alto por defecto porque "Pensamiento Profundo"/"Búsqueda inteligente"
# alargan bastante las respuestas si están activados en la UI de DeepSeek.
RESPONSE_TIMEOUT_MS=300000

# NORMALMENTE NO HACE FALTA TOCAR ESTO: dscode detecta automáticamente un
# Chromium/Chrome ya instalado en tu sistema (Linux, macOS o Windows), sin
# importar el usuario o la máquina. Solo llena esta variable si quieres
# forzar un binario específico. Comentada = autodetección real.
#   - Ruta ABSOLUTA: se usa tal cual, en cualquier sistema operativo.
#   - Ruta RELATIVA (ej. "./chrome-bin/chrome"): se resuelve relativa a
#     la carpeta de instalación de dscode, nunca al proyecto que abras.
CHROMIUM_EXECUTABLE_PATH=./chrome-linux64/chrome

# Máximo de chars de AGENTS.md + anidados inyectados al system prompt.
# AJUSTADO 2026-09-10: el prompt base de dscode (identidad+reglas+workflow,
# src/app/agent/prompt.ts) ya pesa ~11.8k chars por sí solo. Sumado a las
# instrucciones de tools (~1.5k) y tags, con DSCODE_MAX_SEND_CHARS=16000
# el presupuesto REAL para contexto de proyecto es de solo ~2-2.5k antes
# de que webClient.ts tenga que recortarlo. Bajado de 12000 a 6000 para
# que el recorte sea la excepción (mensajes largos) y no la norma en cada
# turno. Si tu AGENTS.md es corto, podés subirlo; si subís mucho, el
# recorte automático (ahora seguro, ver webClient.ts:capTextToSend) sigue
# protegiendo tu pedido y las tools, solo que se comerá más contexto.
DSCODE_MAX_CONTEXT_CHARS=5000

# Cap final del payload enviado al browser (system+user+tools). Evita 24k+ que
# revienta textarea aunque el contexto ya esté truncado. Default 16000.
# NO SUBIR sin volver a probar contra el bug de textarea.evaluate
# (countBefore=0) que mencionás en el README — 16000 fue tu límite empírico
# seguro. El recorte ahora es inteligente (protege [USER] y HERRAMIENTAS),
# así que subir esto ya no es necesario para que el agente funcione bien.
DSCODE_MAX_SEND_CHARS=16000
