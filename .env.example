# ============================================================
# dscode — motor único: chat.deepseek.com vía Playwright
# ============================================================
CHAT_URL=https://chat.deepseek.com/

# Chromium corre oculto (sin ventana). "dscode login" y "dscode calibrate"
# fuerzan ventana visible siempre, sin importar esto (necesitan que veas
# la pantalla para iniciar sesión).
HEADLESS=true

# Dónde se guarda la sesión logueada (cookies, localStorage). Ruta
# relativa a la carpeta de instalación de dscode (NO al proyecto que
# abras con él) — no hace falta tocar esto normalmente.
STORAGE_STATE_PATH=./storage-state.json

# Timeout máximo (ms) esperando a que termine de generarse una respuesta.
# Alto por defecto porque "Pensamiento Profundo"/"Búsqueda inteligente"
# alargan bastante las respuestas si están activados en la UI de DeepSeek.
RESPONSE_TIMEOUT_MS=300000

# NORMALMENTE NO HACE FALTA TOCAR ESTO: dscode detecta automáticamente un
# Chromium/Chrome ya instalado en tu sistema (Linux, macOS o Windows), sin
# importar el usuario o la máquina. Solo llena esta variable si quieres
# forzar un binario específico:
#   - Ruta ABSOLUTA: se usa tal cual, en cualquier sistema operativo.
#   - Ruta RELATIVA (ej. "./chrome-bin/chrome"): se resuelve relativa a
#     la carpeta de instalación de dscode, nunca al proyecto que abras.
CHROMIUM_EXECUTABLE_PATH=

# Máximo de chars de AGENTS.md inyectados al system prompt (loader.ts).
# Default 12000 — el-mandado tiene ~31k y 35000 reventaba el textarea.
DSCODE_MAX_CONTEXT_CHARS=12000

# Cap final del payload enviado al browser (system+user+tools).
# Evita 24k+ que revienta evaluate aunque el contexto ya esté truncado.
DSCODE_MAX_SEND_CHARS=16000
